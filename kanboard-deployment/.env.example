# ============================================================================
# Kanboard Environment Configuration Template
# ============================================================================
#
# SETUP INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values below
# 3. NEVER commit .env to git - it contains secrets!
#
# ============================================================================

# ============================================================================
# APPLICATION SETTINGS (REQUIRED)
# ============================================================================

# Your public domain - CRITICAL for fixing OAuth redirect_uri_mismatch error
# Examples:
#   - http://tasks.verslib.re
#   - https://kanboard.yourcompany.com
#   - http://your-vm-ip:8080
APPLICATION_URL=http://tasks.verslib.re

# Timezone (optional, defaults to UTC)
TZ=UTC

# ============================================================================
# GOOGLE OAUTH CREDENTIALS (REQUIRED for OAuth)
# ============================================================================
# Get these from: https://console.cloud.google.com/apis/credentials
#
# Steps:
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: ${APPLICATION_URL}/oauth/google/callback
# 3. Copy Client ID and Secret here

GOOGLE_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE

# ============================================================================
# DATABASE CONFIGURATION (OPTIONAL)
# ============================================================================
# By default, Kanboard uses SQLite (no configuration needed)
# Uncomment lines below to use MySQL/PostgreSQL

# Database type: mysql, postgres, or sqlite (default)
# DB_DRIVER=mysql

# MySQL/MariaDB Configuration
# DB_USERNAME=kanboard
# DB_PASSWORD=your_secure_password_here
# DB_HOSTNAME=db
# DB_NAME=kanboard
# DB_PORT=3306

# PostgreSQL Configuration
# DB_DRIVER=postgres
# DB_USERNAME=kanboard
# DB_PASSWORD=your_secure_password_here
# DB_HOSTNAME=db
# DB_NAME=kanboard
# DB_PORT=5432

# ============================================================================
# SECURITY SETTINGS (RECOMMENDED)
# ============================================================================

# Force HTTPS (set to true after SSL is configured)
FORCE_HTTPS=false

# Enable HSTS header (only enable after HTTPS is working)
ENABLE_HSTS=false

# Session timeout in seconds (0 = until browser closes)
SESSION_DURATION=0

# Disable password login (force OAuth only)
# Only enable this AFTER you've confirmed OAuth works and you have admin access
DISABLE_LOGIN_FORM=false

# ============================================================================
# EMAIL CONFIGURATION (OPTIONAL)
# ============================================================================
# Required for email notifications and password resets

# SMTP Transport
# MAIL_TRANSPORT=smtp
# MAIL_SMTP_HOSTNAME=smtp.gmail.com
# MAIL_SMTP_PORT=587
# MAIL_SMTP_USERNAME=your-email@gmail.com
# MAIL_SMTP_PASSWORD=your-app-specific-password
# MAIL_SMTP_ENCRYPTION=tls
# MAIL_FROM=kanboard@verslib.re

# ============================================================================
# ADVANCED SETTINGS (OPTIONAL)
# ============================================================================

# Enable debug mode (DO NOT use in production!)
DEBUG=false

# Log driver: stdout, stderr, syslog, file
# LOG_DRIVER=stdout

# Default language
# DEFAULT_LANGUAGE=en_US

# Max file upload size (bytes)
# FILE_MAX_SIZE=10485760

# ============================================================================
# NOTES
# ============================================================================
#
# OAuth Redirect URI Format:
#   If APPLICATION_URL = http://tasks.verslib.re
#   Then redirect URI = http://tasks.verslib.re/oauth/google/callback
#
# Common Issues:
#   - redirect_uri_mismatch: APPLICATION_URL doesn't match Google OAuth settings
#   - Make sure APPLICATION_URL matches exactly (http vs https, no trailing slash)
#   - After changing .env, restart container: docker-compose restart
#
