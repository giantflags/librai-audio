// ==============================================================================
// CRITICAL: Application URL Configuration
// ==============================================================================
//
// This is THE KEY SETTING that fixes the OAuth redirect_uri_mismatch error!
//
// Set this to your public domain URL where Kanboard is accessible.
// Without this, Kanboard defaults to 'localhost' which breaks OAuth.
//
// Examples:
//   - Production with domain: 'https://tasks.yourcompany.com'
//   - Development: 'http://localhost:8080'
//   - VM with public IP: 'http://your-vm-ip'
//

defined('APPLICATION_URL') or define('APPLICATION_URL', 'REPLACE_WITH_YOUR_DOMAIN');

// Example: defined('APPLICATION_URL') or define('APPLICATION_URL', 'http://tasks.verslib.re');
// Example: defined('APPLICATION_URL') or define('APPLICATION_URL', 'https://kanboard.example.com');

// ==============================================================================
// Reverse Proxy Configuration
// ==============================================================================

// Trust X-Forwarded-* headers from reverse proxy
// Required if using Nginx/Apache reverse proxy with HTTPS termination
defined('REVERSE_PROXY_TRUST_HEADER') or define('REVERSE_PROXY_TRUST_HEADER', true);

// ==============================================================================
// Google OAuth Configuration
// ==============================================================================

// Enable Google OAuth authentication
defined('GOOGLE_AUTH') or define('GOOGLE_AUTH', true);

// Google OAuth Client ID
// Get from: https://console.cloud.google.com/apis/credentials
defined('GOOGLE_CLIENT_ID') or define('GOOGLE_CLIENT_ID', 'REPLACE_WITH_YOUR_CLIENT_ID');

// Google OAuth Client Secret
// Get from: https://console.cloud.google.com/apis/credentials
defined('GOOGLE_CLIENT_SECRET') or define('GOOGLE_CLIENT_SECRET', 'REPLACE_WITH_YOUR_CLIENT_SECRET');

